def correct_pos_format(string):
    if not isinstance(string, str):
        return False
    if len(string) == 3:
        piece, col, row = string[0], string[1], string[2]
        return (
            piece.upper() in "KQBNRP" and
            col in "abcdefgh" and
            row in "12345678"
        )
    elif len(string) == 2:
        col, row = string[0], string[1]
        return (
            col in "abcdefgh" and
            row in "12345678"
        )

    return False


class Player:
  def self (color,name)
    self.name = name
    self.color = color

  def askMove ()
    while True do:
      move = input(f"{self.name} ({'Blanc' if self.color == 0 else 'Noir'}), entrez votre coup : ")

      pos = move.split()

      if len(pos) == 2 and correct_pos_format(pos[0]) and correct_pos_format(pos[1]):
                return pos
            else:
                print("Format invalide. Exemple : Nb1 Nc3")

class Board:
    def __init__(self):
        self.grid = {}

    def addPiece(self, piece):
        self.grid[(piece.position.column, piece.position.row)] = piece

    def getPiece(self, position):
        return self.grid.get((position.column, position.row))

    def movePiece(self, piece, newPosition):
        if piece.isValidMove(newPosition, self):
            old_pos = (piece.position.column, piece.position.row)
            new_pos = (newPosition.column, newPosition.row)

            # si une pièce adverse est là, elle est remplacée
            if new_pos in self.grid:
                del self.grid[new_pos]

            del self.grid[old_pos]
            piece.position = newPosition
            self.grid[new_pos] = piece
            return True

        return False
