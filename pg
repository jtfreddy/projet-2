    # --- vérification fin de partie ---
    def _check_game_over(self):
        self.turn_count += 1
        if self.rotation_mode and self.turn_count % 2 == 0:
            self._animate_rotation()
        if self.game.isCheckMate():
            self.game_over = True
            self.winner = (self.game.players[1]
                           if self.game.currentPlayer is self.game.players[0]
                           else self.game.players[0])
            self.end_reason = "ECHEC ET MAT"
        elif self.game.isStalemate():
            self.game_over  = True
            self.winner     = None
            self.end_reason = "EGALITE (PAT)"
    # --- animation rotation ---
    def _animate_rotation(self):
        """Anime la rotation du plateau de 90° puis applique rotate90() sur le Board."""
        steps  = 18          # nombre de frames
        deg_per_step = 90 / steps
        cx = BOARD_X + BOARD_SIZE // 2
        cy = BOARD_Y + BOARD_SIZE // 2

        board_surf = pygame.Surface((BOARD_SIZE, BOARD_SIZE), pygame.SRCALPHA)
        for ci, col in enumerate(VALID_COLUMNS):
            for row in range(1, 9):
                pos    = Position(col, row)
                px     = ci * SQUARE_SIZE
                py     = (7 - (row - 1)) * SQUARE_SIZE
                base   = COLOR_LIGHT if (ci + row) % 2 == 0 else COLOR_DARK
                pygame.draw.rect(board_surf, base, (px, py, SQUARE_SIZE, SQUARE_SIZE))
                piece = self.game.board.getPiece(pos)
                if piece:
                    imgs = self.piece_images.get(str(piece))
                    if imgs:
                        img = imgs[0 if piece.is_white() else 1]
                        board_surf.blit(img, img.get_rect(
                            center=(px + SQUARE_SIZE//2, py + SQUARE_SIZE//2)))

        for step in range(steps + 1):
            angle = step * deg_per_step
            rotated = pygame.transform.rotate(board_surf, -angle)
            scale = BOARD_SIZE / max(rotated.get_width(), rotated.get_height())
            if scale < 1:
                nw = int(rotated.get_width()  * scale)
                nh = int(rotated.get_height() * scale)
                rotated = pygame.transform.smoothscale(rotated, (nw, nh))

            self.screen.fill(BG_COLOR)
            self._draw_labels()
            self._draw_panel()
            self.screen.blit(rotated, rotated.get_rect(center=(cx, cy)))
            pygame.display.flip()
            self.clock.tick(60)
            pygame.event.pump()   # éviter que la fenêtre freeze

        self.game.board.rotate90()
        self.selected_pos   = None
        self.valid_moves    = []
        self.last_move_from = None
        self.last_move_to   = None
        self.message        = "Plateau tourne !"

    # --- menu de promotion ---
    def _show_promotion_menu(self, pos: Position, color: int):
        """Affiche un menu pour choisir la pièce de promotion."""
        options   = [Queen, Rook, Bishop, Knight]
        labels    = ["Reine", "Tour", "Fou", "Cavalier"]
        keys      = ['Q',     'R',    'B',   'N']
        bw, bh    = 120, 50
        total_w   = len(options) * bw + (len(options) - 1) * 10
        sx        = WIN_W // 2 - total_w // 2
        sy        = WIN_H // 2 - bh // 2
        rects     = [pygame.Rect(sx + i * (bw + 10), sy, bw, bh) for i in range(len(options))]

        choosing = True
        while choosing:
            self.screen.fill(BG_COLOR)
            self._draw_board(); self._draw_pieces(); self._draw_labels(); self._draw_panel()
            overlay = pygame.Surface((WIN_W, WIN_H), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 160))
            self.screen.blit(overlay, (0, 0))
            self._text(self.screen, "Choisissez la promotion :",
                       self.font_title, PANEL_TEXT, WIN_W // 2, sy - 40)

            mx, my = pygame.mouse.get_pos()
            for i, (rect, label) in enumerate(zip(rects, labels)):
                col = BTN_HOVER if rect.collidepoint(mx, my) else BTN_COLOR
                pygame.draw.rect(self.screen, col,        rect, border_radius=8)
                pygame.draw.rect(self.screen, BTN_BORDER, rect, 2, border_radius=8)
                img_key = keys[i]
                imgs = self.piece_images.get(img_key)
                if imgs:
                    img = imgs[0 if color == WHITE else 1]
                    self.screen.blit(img, img.get_rect(center=(rect.centerx, rect.centery - 8)))
                self._text(self.screen, label, self.font_info, BTN_TEXT,
                           rect.centerx, rect.bottom - 14)

            pygame.display.flip()
            self.clock.tick(30)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    for i, rect in enumerate(rects):
                        if rect.collidepoint(event.pos):
                            self.game.promote_pawn(pos, options[i])
                            choosing = False
                            break

        self.game.switchPlayer()
        self._check_game_over()

    # --- tour IA ---
    def _do_ai_turn(self):
        if self.game_over: return
        cp = self.game.currentPlayer
        if not isinstance(cp, AIPlayer): return
        pygame.time.delay(400)
        move = cp.askMove(board=self.game.board, chess=self.game)
        if not move:
            self.game_over = True
            self.winner    = self.game.players[0 if cp.get_color() == BLACK else 1]
            self.message   = "L'IA n'a plus de coup !"
            return
        if self.game.isValidMove(move):
            try:
                _, fp, _, tp = self.game._parse_move(move)
                self.last_move_from = fp
                self.last_move_to   = tp
            except Exception:
                pass
            self.game.updateBoard(move)
            self.message = f"IA : {move}"
            if self.game.isCheckMate():
                self.game_over = True; self.winner = cp
            else:
                self.game.switchPlayer()
        else:
            self.message = "Coup IA invalide."

    # --- clic sur le plateau ---
    def _handle_click(self, px, py):
        if self.game_over: return
        clicked = self._pixel_to_pos(px, py)
        if clicked is None: return
        cp       = self.game.currentPlayer
        if isinstance(cp, AIPlayer): return
        piece_at = self.game.board.getPiece(clicked)

        if self.selected_pos is None:
            if piece_at and piece_at.get_color() == cp.get_color():
                self.selected_pos = clicked
                self.valid_moves  = self._compute_valid_moves(clicked)
                self.message      = f"Piece selectionnee : {clicked}"
            else:
                self.message = "Selectionne une de tes pieces."
            return

        if piece_at and piece_at.get_color() == cp.get_color():
            selected_piece = self.game.board.getPiece(self.selected_pos)
            if isinstance(selected_piece, King) and isinstance(piece_at, Rook):
                king     = selected_piece
                rook_pos = clicked
                kingside = rook_pos.col_index() > self.selected_pos.col_index()
                if self.game.is_castling_valid(king, kingside):
                    row      = self.selected_pos.get_row()
                    king_dest = Position('g' if kingside else 'c', row)
                    rook_dest = Position('f' if kingside else 'd', row)
                    self.last_move_from = self.selected_pos
                    self.last_move_to   = king_dest
                    self.game.board.castle_move(king, piece_at, king_dest, rook_dest)
                    self.message      = f"Roque {'petit' if kingside else 'grand'} !"
                    self.selected_pos = None
                    self.valid_moves  = []
                    if self.game.isCheckMate():
                        self.game_over = True; self.winner = cp
                    else:
                        self.game.switchPlayer()
                    return
            self.selected_pos = clicked
            self.valid_moves  = self._compute_valid_moves(clicked)
            self.message      = f"Piece selectionnee : {clicked}"
            return

        piece = self.game.board.getPiece(self.selected_pos)
        if piece is None:
            self.selected_pos = None; self.valid_moves = []; return

        move_str = f"{str(piece).upper()}{self.selected_pos} {str(piece).upper()}{clicked}"
        if self.game.isValidMove(move_str):
            self.last_move_from = self.selected_pos
            self.last_move_to   = clicked
            self.game.updateBoard(move_str)
            self.message      = f"{self.selected_pos} -> {clicked}"
            self.selected_pos = None
            self.valid_moves  = []
            piece_moved = self.game.board.getPiece(clicked)
            if isinstance(piece_moved, Pawn) and piece_moved.is_at_promotion():
                self._show_promotion_menu(clicked, piece_moved.get_color())
                return  # switchPlayer après la promotion
            self.game.switchPlayer()
            self._check_game_over()
        else:
            self.message      = "Deplacement invalide."
            self.selected_pos = None
            self.valid_moves  = []

    # --- boucle principale ---
    def run(self):
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()

                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    px, py = event.pos
                    if (BOARD_X <= px < BOARD_X + BOARD_SIZE and
                            BOARD_Y <= py < BOARD_Y + BOARD_SIZE):
                        self._handle_click(px, py)

                    if self.btn_save.is_clicked(event):
                        self.game.save_game()
                        self.message = "Partie sauvegardee !"

                    if self.btn_load.is_clicked(event):
                        if self.game.load_game():
                            self.selected_pos = None; self.valid_moves = []
                            self.game_over = False;   self.winner = None
                            self.message   = "Partie chargee !"
                        else:
                            self.message = "Aucune sauvegarde trouvee."

                    if self.btn_restart.is_clicked(event):
                        self.selected_pos = None; self.valid_moves = []
                        self.message = ""
                        self._show_start_screen()

            if (not self.game_over and self.game.currentPlayer and
                    isinstance(self.game.currentPlayer, AIPlayer)):
                self._do_ai_turn()

            self.screen.fill(BG_COLOR)
            self._draw_board()
            self._draw_pieces()
            self._draw_labels()
            self._draw_panel()

            if self.game_over:
                ov = pygame.Surface((WIN_W, WIN_H), pygame.SRCALPHA)
                ov.fill((0, 0, 0, 150))
                self.screen.blit(ov, (0, 0))
                self._text(self.screen, self.end_reason,
                           self.font_title, (255, 210, 50), WIN_W // 2, WIN_H // 2 - 40)
                if self.winner:
                    self._text(self.screen, f"{self.winner.get_name()} remporte la partie !",
                               self.font_info, (240, 200, 120), WIN_W // 2, WIN_H // 2)
                else:
                    self._text(self.screen, "Aucun gagnant — partie nulle !",
                               self.font_info, (200, 200, 200), WIN_W // 2, WIN_H // 2)
                self._text(self.screen, "Cliquez sur Nouvelle partie",
                           self.font_info, PANEL_TEXT2, WIN_W // 2, WIN_H // 2 + 45)

            pygame.display.flip()
            self.clock.tick(60)

#  POINT D'ENTRÉE

if __name__ == "__main__":
