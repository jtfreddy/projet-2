#  10. PLAYER  /  11. AIPLAYER
# ══════════════════════════════════════════════════════════════════════════════
class Player:
    def __init__(self, name: str, color: int):
        self.__name  = name
        self.__color = color

    def get_name(self)  -> str:  return self.__name
    def get_color(self) -> int:  return self.__color
    def is_white(self)  -> bool: return self.__color == WHITE
    def __str__(self):
        return f"{self.__name} ({'Blancs' if self.__color == WHITE else 'Noirs'})"

class AIPlayer(Player):
    def __init__(self, name: str, color: int):
        super().__init__(name, color)

    def askMove(self, board: Board = None, chess=None) -> str:
        """Coup aléatoire rapide : collecte les candidats puis filtre l'échec."""
        if board is None: return ""
        color = self.get_color()
        pieces = board.get_all_pieces(color)
        random.shuffle(pieces)
        candidates = []
        for piece in pieces:
            pos = piece.get_position()
            if pos is None: continue
            for dest in [Position(col, row) for col in VALID_COLUMNS for row in range(1, 9)]:
                if dest == pos: continue
                try:
                    if piece.isValidMove(dest, board):
                        candidates.append((piece, pos, dest))
                except Exception:
                    continue
        random.shuffle(candidates)
        for piece, pos, dest in candidates:
            try:
                if chess and chess._move_leaves_king_in_check(piece, dest, color):
                    continue
                return f"{str(piece).upper()}{pos} {str(piece).upper()}{dest}"
            except Exception:
                continue
        return ""

