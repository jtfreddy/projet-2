    def _pos_to_pixel(self, pos: Position):
        return (BOARD_X + pos.col_index() * SQUARE_SIZE,
                BOARD_Y + (7 - pos.row_index()) * SQUARE_SIZE)

    def _pixel_to_pos(self, px, py):
        col = (px - BOARD_X) // SQUARE_SIZE
        row = 7 - (py - BOARD_Y) // SQUARE_SIZE
        if 0 <= col <= 7 and 0 <= row <= 7:
            return Position(VALID_COLUMNS[col], row + 1)
        return None

    def _text(self, surf, txt, font, color, cx, cy):
        s = font.render(txt, True, color)
        surf.blit(s, s.get_rect(center=(cx, cy)))

    def _wrap(self, text, font, max_w):
        words, lines, cur = text.split(), [], ""
        for w in words:
            t = (cur + " " + w).strip()
            if font.size(t)[0] <= max_w: cur = t
            else:
                if cur: lines.append(cur)
                cur = w
        if cur: lines.append(cur)
        return lines

