#  3-8. PIÈCES
# ══════════════════════════════════════════════════════════════════════════════
class King(Piece):
    def __str__(self): return 'K'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if dc <= 1 and dr <= 1 and (dc + dr) > 0:
            return True
        # Roque : le roi se déplace de 2 cases sur la même rangée
        # La validation complète (cases libres, non menacées, pas déjà bougé)
        # est faite dans Chess.is_castling_valid() — ici on accepte juste le format
        if dr == 0 and dc == 2:
            return True   # Chess.isValidMove() fera la vérification complète
        return False

class Queen(Piece):
    def __str__(self): return 'Q'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if not (((dc == 0 or dr == 0) and dc + dr > 0) or (dc == dr and dc > 0)): return False
        return self._path_clear(newPosition, board)

class Bishop(Piece):
    def __str__(self): return 'B'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if dc != dr or dc == 0: return False
        return self._path_clear(newPosition, board)

class Knight(Piece):
    def __str__(self): return 'N'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        return (dc == 2 and dr == 1) or (dc == 1 and dr == 2)

class Rook(Piece):
    def __str__(self): return 'R'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if not ((dc == 0 and dr > 0) or (dr == 0 and dc > 0)): return False
        return self._path_clear(newPosition, board)

class Pawn(Piece):
    def __init__(self, position, color):
        super().__init__(position, color)
        # Direction d'avance : +1 = Nord (vers rangée 8), -1 = Sud (vers rangée 1)
        # En mode normal : Blancs=+1, Noirs=-1
        # Après une rotation du plateau : tous les pions avancent vers le haut = +1
        self._dir = 1 if color == WHITE else -1

    def __str__(self): return 'P'

    def set_direction(self, d: int):
        """Force la direction : +1 = vers rangée 8, -1 = vers rangée 1."""
        self._dir = d

    def _start_row(self) -> bool:
        """Vrai si le pion est sur sa rangée de départ (peut avancer de 2)."""
        if self._dir == 1: return self._position.row_index() == 1   # rangée 2
        else:              return self._position.row_index() == 6   # rangée 7

    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        cn, rn = self._position.col_index(), self._position.row_index()
        cd, rd = newPosition.col_index(),    newPosition.row_index()
        dc, dr = cd - cn, rd - rn

        if dc == 0 and dr == self._dir:
            return board.getPiece(newPosition) is None

        if dc == 0 and dr == 2 * self._dir and self._start_row():
            mid = Position(VALID_COLUMNS[cn], rn + self._dir + 1)
            return board.getPiece(mid) is None and board.getPiece(newPosition) is None

        if abs(dc) == 1 and dr == self._dir:
            t = board.getPiece(newPosition)
            return t is not None and t.get_color() != self._color

        return False

    def threatens(self, newPosition) -> bool:
        """Vrai si ce pion attaque la case (sans vérifier l'occupation)."""
        cn, rn = self._position.col_index(), self._position.row_index()
        cd, rd = newPosition.col_index(),    newPosition.row_index()
        return abs(cd - cn) == 1 and (rd - rn) == self._dir

    def is_at_promotion(self) -> bool:
        """Vrai si le pion est arrivé en dernière rangée."""
        if self._dir == 1: return self._position.row_index() == 7  # rangée 8
        else:              return self._position.row_index() == 0  # rangée 1

