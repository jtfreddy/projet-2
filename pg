#  1. POSITION
# ══════════════════════════════════════════════════════════════════════════════
class Position:
    """Représente une case de l'échiquier (ex: 'e4')."""

    def __init__(self, column: str, row: int):
        if column not in VALID_COLUMNS:
            raise ValueError(f"Colonne invalide : '{column}'.")
        if row not in VALID_ROWS:
            raise ValueError(f"Rangée invalide : {row}.")
        self.__column = column
        self.__row    = row

    def get_column(self) -> str: return self.__column
    def get_row(self)    -> int: return self.__row
    def col_index(self)  -> int: return VALID_COLUMNS.index(self.__column)
    def row_index(self)  -> int: return self.__row - 1

    def __str__(self)  -> str:  return f"{self.__column}{self.__row}"
    def __repr__(self) -> str:  return f"Position('{self.__column}', {self.__row})"

    def __eq__(self, other) -> bool:
        if not isinstance(other, Position): return False
        return self.__column == other.__column and self.__row == other.__row

    def __hash__(self):
        return hash((self.__column, self.__row))

    @staticmethod
    def from_string(s: str) -> "Position":
        if len(s) != 2:
            raise ValueError(f"Position invalide : '{s}'")
        return Position(s[0].lower(), int(s[1]))

