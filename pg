#  9. BOARD
# ══════════════════════════════════════════════════════════════════════════════
_PIECE_TYPE_MAP = {'K': King, 'Q': Queen, 'B': Bishop, 'N': Knight, 'R': Rook, 'P': Pawn}

class Board:
    """Échiquier : dictionnaire {Position → Piece} + liste de capturées."""

    def __init__(self):
        self.__pieces:   dict = {}
        self.__captured: list = []
        self.__moved:    set  = set()   # ensemble des pièces qui ont déjà bougé
        self._setup()

    def _setup(self):
        for i, cls in enumerate([Rook, Knight, Bishop, Queen, King, Bishop, Knight, Rook]):
            col = VALID_COLUMNS[i]
            self.__pieces[Position(col, 1)] = cls(Position(col, 1), WHITE)
            self.__pieces[Position(col, 8)] = cls(Position(col, 8), BLACK)
        for col in VALID_COLUMNS:
            self.__pieces[Position(col, 2)] = Pawn(Position(col, 2), WHITE)
            self.__pieces[Position(col, 7)] = Pawn(Position(col, 7), BLACK)

    def getPiece(self, position: Position):
        return self.__pieces.get(position, None)

    def getPosition(self, piece: Piece):
        for pos, p in self.__pieces.items():
            if p is piece: return pos
        return None

    def get_all_pieces(self, color: int = None) -> list:
        if color is None: return list(self.__pieces.values())
        return [p for p in self.__pieces.values() if p.get_color() == color]

    def get_captured(self) -> list:
        return list(self.__captured)

    def has_moved(self, piece: Piece) -> bool:
        """Retourne True si cette pièce a déjà bougé depuis le début de la partie."""
        return piece in self.__moved

    def rotate90(self):
        """Fait tourner le plateau de 90° dans le sens horaire.
        Transformation (0-based) : (c, r) → (r, 7-c)
        Après rotation : tous les pions avancent vers le haut de l'écran (dir=+1).
        """
        new_pieces = {}
        for pos, piece in self.__pieces.items():
            c_idx = pos.col_index()
            r_idx = pos.row_index()
            new_col = VALID_COLUMNS[r_idx]
            new_row = 8 - c_idx   # 1-based
            new_pos = Position(new_col, new_row)
            piece.set_position(new_pos)
            if isinstance(piece, Pawn):
                piece.set_direction(1)   # tous vers le haut après rotation
            new_pieces[new_pos] = piece
        self.__pieces = new_pieces

    def move_piece(self, piece: Piece, new_position: Position):
        old    = piece.get_position()
        target = self.getPiece(new_position)
        if target is not None:
            del self.__pieces[new_position]
            target.set_position(None)
            self.__captured.append(target)
        del self.__pieces[old]
        piece.set_position(new_position)
        self.__pieces[new_position] = piece
        self.__moved.add(piece)   # marquer la pièce comme ayant bougé

    def castle_move(self, king: "King", rook: "Rook", king_dest: Position, rook_dest: Position):
        """Effectue le roque : déplace le roi et la tour simultanément."""
        del self.__pieces[king.get_position()]
        del self.__pieces[rook.get_position()]
        king.set_position(king_dest)
        self.__pieces[king_dest] = king
        self.__moved.add(king)
        rook.set_position(rook_dest)
        self.__pieces[rook_dest] = rook
        self.__moved.add(rook)

    def to_dict(self) -> dict:
        # On encode l'id des pièces ayant bougé via leur position actuelle
        moved_positions = [str(p.get_position()) for p in self.__moved
                           if p.get_position() is not None]
        return {
            'pieces': [{'col': pos.get_column(), 'row': pos.get_row(),
                        'type': str(p), 'color': p.get_color()}
                       for pos, p in self.__pieces.items()],
            'captured': [{'type': str(p), 'color': p.get_color()}
                         for p in self.__captured],
            'moved': moved_positions
        }

    @classmethod
    def from_dict(cls, data: dict) -> "Board":
        b = cls.__new__(cls)
        b._Board__pieces   = {}
        b._Board__captured = []
        b._Board__moved    = set()
        for e in data['pieces']:
            pos = Position(e['col'], e['row'])
            p   = _PIECE_TYPE_MAP[e['type']](pos, e['color'])
            b._Board__pieces[pos] = p
        for e in data.get('captured', []):
            p = _PIECE_TYPE_MAP[e['type']](Position('a', 1), e['color'])
            p.set_position(None)
            b._Board__captured.append(p)
        # Restaurer les pièces ayant bougé
        moved_pos_strs = set(data.get('moved', []))
        for pos, p in b._Board__pieces.items():
            if str(pos) in moved_pos_strs:
                b._Board__moved.add(p)
        return b

