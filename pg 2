#  2. PIECE (abstraite)
# ══════════════════════════════════════════════════════════════════════════════
class Piece(ABC):
    def __init__(self, position: Position, color: int):
        self._position = position
        self._color    = color

    def get_position(self) -> Position: return self._position
    def set_position(self, p):          self._position = p
    def get_color(self)    -> int:      return self._color
    def is_white(self)     -> bool:     return self._color == WHITE

    @abstractmethod
    def isValidMove(self, newPosition: Position, board: "Board") -> bool: pass

    @abstractmethod
    def __str__(self) -> str: pass

    def _is_same_color_at(self, position: Position, board: "Board") -> bool:
        p = board.getPiece(position)
        return p is not None and p.get_color() == self._color

    def _path_clear(self, newPosition: Position, board: "Board") -> bool:
        c1, r1 = self._position.col_index(), self._position.row_index()
        c2, r2 = newPosition.col_index(),    newPosition.row_index()
        dc = 0 if c2 == c1 else (1 if c2 > c1 else -1)
        dr = 0 if r2 == r1 else (1 if r2 > r1 else -1)
        c, r = c1 + dc, r1 + dr
        while (c, r) != (c2, r2):
            if board.getPiece(Position(VALID_COLUMNS[c], r + 1)) is not None:
                return False
            c += dc; r += dr
        return True


