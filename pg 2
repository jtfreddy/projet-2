#  10. PLAYER  /  11. AIPLAYER
# ══════════════════════════════════════════════════════════════════════════════
class Player:
    def __init__(self, name: str, color: int):
        self.__name  = name
        self.__color = color

    def get_name(self)  -> str:  return self.__name
    def get_color(self) -> int:  return self.__color
    def is_white(self)  -> bool: return self.__color == WHITE
    def __str__(self):
        return f"{self.__name} ({'Blancs' if self.__color == WHITE else 'Noirs'})"


class AIPlayer(Player):
    def __init__(self, name: str, color: int):
        super().__init__(name, color)

    def askMove(self, board: Board = None) -> str:
        if board is None: return ""
        pieces = board.get_all_pieces(self.get_color())
        random.shuffle(pieces)
        for piece in pieces:
            pos = piece.get_position()
            if pos is None: continue
            dests = [Position(c, r) for c in VALID_COLUMNS for r in range(1, 9)]
            random.shuffle(dests)
            for dest in dests:
                if dest == pos: continue
                try:
                    if piece.isValidMove(dest, board):
                        return f"{str(piece).upper()}{pos} {str(piece).upper()}{dest}"
                except Exception:
                    continue
        return ""


