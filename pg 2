#  CHESSUI
# ══════════════════════════════════════════════════════════════════════════════
class ChessUI:
    def __init__(self):
        pygame.init()
        pygame.display.set_caption("Echecs Medievaux")
        self.screen  = pygame.display.set_mode((WIN_W, WIN_H))
        self.clock   = pygame.time.Clock()

        self.font_piece  = pygame.font.SysFont(PIECE_FONT_NAME, PIECE_FONT_SIZE, bold=True)
        self.font_label  = pygame.font.SysFont(LABEL_FONT_NAME, LABEL_FONT_SIZE)
        self.font_info   = pygame.font.SysFont(INFO_FONT_NAME,  INFO_FONT_SIZE)
        self.font_title  = pygame.font.SysFont(INFO_FONT_NAME,  TITLE_FONT_SIZE, bold=True)
        self.font_btn    = pygame.font.SysFont(INFO_FONT_NAME,  INFO_FONT_SIZE,  bold=True)

        self.game         = Chess()
        self.selected_pos = None
        self.valid_moves  = []
        self.message      = ""
        self.game_over    = False
        self.winner       = None
        self.last_move_from = None   # case de départ du dernier coup joué
        self.last_move_to   = None   # case d'arrivée du dernier coup joué
        self.overlay      = pygame.Surface((SQUARE_SIZE, SQUARE_SIZE), pygame.SRCALPHA)

        # Chargement des images depuis le base64 embarqué dans le code
        import base64, io
        img_size = SQUARE_SIZE - 10
        self.piece_images = {}
        for key, (name_w, name_b) in PIECE_SYMBOLS.items():
            try:
                raw_w = base64.b64decode(_PIECE_B64[name_w])
                raw_b = base64.b64decode(_PIECE_B64[name_b])
                img_w = pygame.image.load(io.BytesIO(raw_w)).convert_alpha()
                img_b = pygame.image.load(io.BytesIO(raw_b)).convert_alpha()
                self.piece_images[key] = (
                    pygame.transform.smoothscale(img_w, (img_size, img_size)),
                    pygame.transform.smoothscale(img_b, (img_size, img_size)),
                )
            except Exception as e:
                print(f"Erreur chargement image {name_w}/{name_b} : {e}")
                self.piece_images[key] = None

        bx, bw, bh = PANEL_X + 10, PANEL_WIDTH - 20, 36
        self.btn_save    = Button(bx, WIN_H - 130, bw, bh, "Sauvegarder")
        self.btn_load    = Button(bx, WIN_H - 85,  bw, bh, "Charger")
        self.btn_restart = Button(bx, WIN_H - 40,  bw, bh, "Nouvelle partie")

        self._show_start_screen()

    # --- utils ---
    def _pos_to_pixel(self, pos: Position):
        return (BOARD_X + pos.col_index() * SQUARE_SIZE,
                BOARD_Y + (7 - pos.row_index()) * SQUARE_SIZE)

    def _pixel_to_pos(self, px, py):
        col = (px - BOARD_X) // SQUARE_SIZE
        row = 7 - (py - BOARD_Y) // SQUARE_SIZE
        if 0 <= col <= 7 and 0 <= row <= 7:
            return Position(VALID_COLUMNS[col], row + 1)
        return None

    def _text(self, surf, txt, font, color, cx, cy):
        s = font.render(txt, True, color)
        surf.blit(s, s.get_rect(center=(cx, cy)))

    def _wrap(self, text, font, max_w):
        words, lines, cur = text.split(), [], ""
        for w in words:
            t = (cur + " " + w).strip()
            if font.size(t)[0] <= max_w: cur = t
            else:
                if cur: lines.append(cur)
                cur = w
        if cur: lines.append(cur)
        return lines

    # --- écran de démarrage ---
    def _show_start_screen(self):
        names, active = ["", ""], 0
        labels = ["Blancs", "Noirs"]
        while True:
            self.screen.fill(BG_COLOR)
            self._text(self.screen, "ECHECS MEDIEVAUX",
                       self.font_title, PANEL_TEXT, WIN_W // 2, WIN_H // 2 - 130)
            self._text(self.screen, "Entrez vos noms  (AI = ordinateur)",
                       self.font_info, PANEL_TEXT2, WIN_W // 2, WIN_H // 2 - 95)

            for i in range(2):
                lx, ly = WIN_W // 2 - 150, WIN_H // 2 - 55 + i * 65
                self.screen.blit(
                    self.font_info.render(labels[i], True, PANEL_TEXT), (lx, ly))
                box = pygame.Rect(lx, ly + 22, 300, 36)
                pygame.draw.rect(self.screen, (60, 35, 10), box, border_radius=5)
                pygame.draw.rect(self.screen,
                                 PANEL_BORDER if active == i else (80, 55, 20),
                                 box, 2, border_radius=5)
                self.screen.blit(
                    self.font_info.render(
                        names[i] + ("|" if active == i else ""), True, PANEL_TEXT),
                    (box.x + 8, box.y + 8))

            mx, my = pygame.mouse.get_pos()
            sr = pygame.Rect(WIN_W // 2 - 80, WIN_H // 2 + 90, 160, 40)
            pygame.draw.rect(self.screen,
                             BTN_HOVER if sr.collidepoint(mx, my) else BTN_COLOR,
                             sr, border_radius=8)
            pygame.draw.rect(self.screen, BTN_BORDER, sr, 2, border_radius=8)
            self._text(self.screen, "Commencer", self.font_btn, BTN_TEXT,
                       sr.centerx, sr.centery)

            pygame.display.flip()
            self.clock.tick(30)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                if event.type == pygame.MOUSEBUTTONDOWN:
                    for i in range(2):
                        box = pygame.Rect(WIN_W // 2 - 150,
                                          WIN_H // 2 - 33 + i * 65, 300, 36)
                        if box.collidepoint(event.pos): active = i
                    if sr.collidepoint(event.pos):
                        self._init_game(names); return
                if event.type == pygame.KEYDOWN:
                    if   event.key == pygame.K_TAB:       active = 1 - active
                    elif event.key == pygame.K_RETURN:
                        if active == 0: active = 1
                        else: self._init_game(names); return
                    elif event.key == pygame.K_BACKSPACE:  names[active] = names[active][:-1]
                    elif len(names[active]) < 20:           names[active] += event.unicode

    def _init_game(self, names):
        self.game = Chess()
        for i, (name, color) in enumerate(zip(names, [WHITE, BLACK])):
            n = name.strip() or f"Joueur{i + 1}"
            if n.upper() == "AI":
                label = "Blancs" if color == WHITE else "Noirs"
                self.game.players.append(AIPlayer(f"IA_{label}", color))
            else:
                self.game.players.append(Player(n, color))
        self.game.currentPlayer = self.game.players[0]
        self.selected_pos = None
        self.valid_moves  = []
        self.message      = ""
        self.game_over    = False
        self.winner       = None
        self.last_move_from = None   # case de départ du dernier coup joué
        self.last_move_to   = None   # case d'arrivée du dernier coup joué

    # --- calcul des coups légaux (filtre aussi les coups qui exposent le roi) ---
    def _compute_valid_moves(self, pos: Position):
        piece = self.game.board.getPiece(pos)
        if piece is None or piece.get_color() != self.game.currentPlayer.get_color():
            return []
        color = self.game.currentPlayer.get_color()
        moves = []
        for col in VALID_COLUMNS:
            for row in range(1, 9):
                dest = Position(col, row)
                if dest == pos: continue
                try:
                    if piece.isValidMove(dest, self.game.board):
                        # Cas roque : validation complète via is_castling_valid
                        if isinstance(piece, King) and abs(dest.col_index() - pos.col_index()) == 2:
                            dc = dest.col_index() - pos.col_index()
                            if self.game.is_castling_valid(piece, dc > 0):
                                moves.append(dest)
                        else:
                            # Exclure les coups qui laisseraient notre roi en échec
                            if not self.game._move_leaves_king_in_check(piece, dest, color):
                                moves.append(dest)
                except Exception:
                    pass
        return moves

    # --- dessin du plateau ---
    def _draw_board(self):
        # Collecte les positions des rois en échec (on vérifie les DEUX couleurs)
        check_positions = set()
        if not self.game_over:
            for color in (WHITE, BLACK):
                if self.game._is_in_check(color):
                    king = self.game._find_king(color)
                    if king: check_positions.add(king.get_position())

        for ci, col in enumerate(VALID_COLUMNS):
            for row in range(1, 9):
                pos    = Position(col, row)
                px, py = self._pos_to_pixel(pos)
                base   = COLOR_LIGHT if (ci + row) % 2 == 0 else COLOR_DARK
                pygame.draw.rect(self.screen, base, (px, py, SQUARE_SIZE, SQUARE_SIZE))

                if self.selected_pos == pos:
                    self.overlay.fill(COLOR_SELECT)
                    self.screen.blit(self.overlay, (px, py))
                elif pos in self.valid_moves:
                    self.overlay.fill(COLOR_MOVE)
                    self.screen.blit(self.overlay, (px, py))
                    pygame.draw.circle(self.screen, (50, 160, 50),
                                       (px + SQUARE_SIZE // 2, py + SQUARE_SIZE // 2), 10)
                elif pos in check_positions:
                    self.overlay.fill(COLOR_CHECK)
                    self.screen.blit(self.overlay, (px, py))
                elif pos == self.last_move_from or pos == self.last_move_to:
                    # Dernier coup joué : encadré en bleu
                    self.overlay.fill(COLOR_LAST)
                    self.screen.blit(self.overlay, (px, py))
                    pygame.draw.rect(self.screen, (70, 130, 220),
                                     (px + 2, py + 2, SQUARE_SIZE - 4, SQUARE_SIZE - 4), 3)

        pygame.draw.rect(self.screen, PANEL_BORDER,
                         (BOARD_X - 3, BOARD_Y - 3, BOARD_SIZE + 6, BOARD_SIZE + 6), 3)

    # --- dessin des pièces ---
    def _draw_pieces(self):
        for col in VALID_COLUMNS:
            for row in range(1, 9):
                pos   = Position(col, row)
                piece = self.game.board.getPiece(pos)
                if piece is None: continue
                px, py = self._pos_to_pixel(pos)
                cx, cy = px + SQUARE_SIZE // 2, py + SQUARE_SIZE // 2
                imgs = self.piece_images.get(str(piece))
                if imgs is None: continue          # image manquante : on ne plante pas
                img = imgs[0 if piece.is_white() else 1]
                self.screen.blit(img, img.get_rect(center=(cx, cy)))

    # --- labels ---
    def _draw_labels(self):
        for i, col in enumerate(VALID_COLUMNS):
            x = BOARD_X + i * SQUARE_SIZE + SQUARE_SIZE // 2
            for y in [BOARD_Y - 25, BOARD_Y + BOARD_SIZE + 8]:
                s = self.font_label.render(col, True, LABEL_COLOR)
                self.screen.blit(s, s.get_rect(center=(x, y)))
        for row in range(1, 9):
            y = BOARD_Y + (7 - (row - 1)) * SQUARE_SIZE + SQUARE_SIZE // 2
            for x in [BOARD_X - 22, BOARD_X + BOARD_SIZE + 22]:
                s = self.font_label.render(str(row), True, LABEL_COLOR)
                self.screen.blit(s, s.get_rect(center=(x, y)))

    # --- panneau latéral ---
    def _draw_panel(self):
        pygame.draw.rect(self.screen, PANEL_BG, (PANEL_X, 0, PANEL_WIDTH + 10, WIN_H))
        pygame.draw.line(self.screen, PANEL_BORDER, (PANEL_X, 0), (PANEL_X, WIN_H), 2)

        y = 15
        self._text(self.screen, "ECHECS MEDIEVAUX", self.font_title,
                   PANEL_TEXT, PANEL_X + PANEL_WIDTH // 2, y + 12)
        y += 40
        pygame.draw.line(self.screen, PANEL_BORDER,
                         (PANEL_X + 10, y), (PANEL_X + PANEL_WIDTH, y))
        y += 14

        if not self.game_over and self.game.currentPlayer:
            cp   = self.game.currentPlayer
            icon = "Blancs" if cp.is_white() else "Noirs"
            self.screen.blit(
                self.font_info.render(f"Tour de :", True, PANEL_TEXT2), (PANEL_X + 12, y))
            y += 22
            self.screen.blit(
                self.font_info.render(f"  {cp.get_name()} ({icon})", True, PANEL_TEXT),
                (PANEL_X + 12, y))
            y += 28
            if self.game._is_in_check(cp.get_color()):
                self.screen.blit(
                    self.font_info.render("EN ECHEC !", True, (220, 80, 80)),
                    (PANEL_X + 12, y))
                y += 26

        elif self.game_over and self.winner:
            for line, col in [
                ("VICTOIRE !", (255, 200, 50)),
                (self.winner.get_name(), PANEL_TEXT),
                ("ECHEC ET MAT", (200, 100, 100))
            ]:
                self.screen.blit(self.font_info.render(line, True, col), (PANEL_X + 12, y))
                y += 26

        y += 8
        pygame.draw.line(self.screen, PANEL_BORDER,
                         (PANEL_X + 10, y), (PANEL_X + PANEL_WIDTH, y))
        y += 14

        for player in self.game.players:
            icon = "B" if player.is_white() else "N"
            tag  = " (IA)" if isinstance(player, AIPlayer) else ""
            s = self.font_info.render(f"[{icon}] {player.get_name()}{tag}", True, PANEL_TEXT2)
            self.screen.blit(s, (PANEL_X + 12, y)); y += 22

        y += 8
        pygame.draw.line(self.screen, PANEL_BORDER,
                         (PANEL_X + 10, y), (PANEL_X + PANEL_WIDTH, y))
        y += 14

        self.screen.blit(
            self.font_info.render("Captures :", True, PANEL_TEXT2), (PANEL_X + 12, y))
        y += 22
        captured = self.game.board.get_captured()
        # Lettres de substitution pour les captures (les images ne sont pas rendables en texte)
        PIECE_LETTERS = {'K': 'Roi', 'Q': 'Rei', 'R': 'Tour', 'B': 'Fou', 'N': 'Cav', 'P': 'P'}
        for label, pieces in [
            ("Blancs :", [p for p in captured if p.get_color() == BLACK]),
            ("Noirs  :", [p for p in captured if p.get_color() == WHITE]),
        ]:
            syms = " ".join(PIECE_LETTERS.get(str(p), str(p)) for p in pieces)
            for chunk in self._wrap(f"{label} {syms or '-'}", self.font_info, PANEL_WIDTH - 20):
                self.screen.blit(
                    self.font_info.render(chunk, True, PANEL_TEXT), (PANEL_X + 12, y))
                y += 20

        y += 8
        pygame.draw.line(self.screen, PANEL_BORDER,
                         (PANEL_X + 10, y), (PANEL_X + PANEL_WIDTH, y))
        y += 14

        if self.message:
            for line in self._wrap(self.message, self.font_info, PANEL_WIDTH - 20):
                self.screen.blit(
                    self.font_info.render(line, True, (200, 160, 80)), (PANEL_X + 12, y))
                y += 20

        mp = pygame.mouse.get_pos()
        self.btn_save.draw(self.screen,    self.font_btn, mp)
        self.btn_load.draw(self.screen,    self.font_btn, mp)
        self.btn_restart.draw(self.screen, self.font_btn, mp)

    # --- tour IA ---
    def _do_ai_turn(self):
        if self.game_over: return
        cp = self.game.currentPlayer
        if not isinstance(cp, AIPlayer): return
        pygame.time.delay(400)
        move = cp.askMove(board=self.game.board)
        if not move:
            self.game_over = True
            self.winner    = self.game.players[0 if cp.get_color() == BLACK else 1]
            self.message   = "L'IA n'a plus de coup !"
            return
        if self.game.isValidMove(move):
            try:
                _, fp, _, tp = self.game._parse_move(move)
                self.last_move_from = fp
                self.last_move_to   = tp
            except Exception:
                pass
            self.game.updateBoard(move)
            self.message = f"IA : {move}"
            if self.game.isCheckMate():
                self.game_over = True; self.winner = cp
            else:
                self.game.switchPlayer()
        else:
            self.message = "Coup IA invalide."

    # --- clic sur le plateau ---
    def _handle_click(self, px, py):
        if self.game_over: return
        clicked = self._pixel_to_pos(px, py)
        if clicked is None: return
        cp       = self.game.currentPlayer
        if isinstance(cp, AIPlayer): return
        piece_at = self.game.board.getPiece(clicked)

        if self.selected_pos is None:
            if piece_at and piece_at.get_color() == cp.get_color():
                self.selected_pos = clicked
                self.valid_moves  = self._compute_valid_moves(clicked)
                self.message      = f"Piece selectionnee : {clicked}"
            else:
                self.message = "Selectionne une de tes pieces."
            return

        if piece_at and piece_at.get_color() == cp.get_color():
            # Cas spécial : si le roi est sélectionné et qu'on clique sur une tour alliée → roque
            selected_piece = self.game.board.getPiece(self.selected_pos)
            if isinstance(selected_piece, King) and isinstance(piece_at, Rook):
                king     = selected_piece
                rook_pos = clicked
                kingside = rook_pos.col_index() > self.selected_pos.col_index()
                if self.game.is_castling_valid(king, kingside):
                    row      = self.selected_pos.get_row()
                    king_dest = Position('g' if kingside else 'c', row)
                    rook_dest = Position('f' if kingside else 'd', row)
                    self.last_move_from = self.selected_pos
                    self.last_move_to   = king_dest
                    self.game.board.castle_move(king, piece_at, king_dest, rook_dest)
                    self.message      = f"Roque {'petit' if kingside else 'grand'} !"
                    self.selected_pos = None
                    self.valid_moves  = []
                    if self.game.isCheckMate():
                        self.game_over = True; self.winner = cp
                    else:
                        self.game.switchPlayer()
                    return
            self.selected_pos = clicked
            self.valid_moves  = self._compute_valid_moves(clicked)
            self.message      = f"Piece selectionnee : {clicked}"
            return

        piece = self.game.board.getPiece(self.selected_pos)
        if piece is None:
            self.selected_pos = None; self.valid_moves = []; return

        move_str = f"{str(piece).upper()}{self.selected_pos} {str(piece).upper()}{clicked}"
        if self.game.isValidMove(move_str):
            self.last_move_from = self.selected_pos   # mémoriser départ
            self.last_move_to   = clicked              # mémoriser arrivée
            self.game.updateBoard(move_str)
            self.message      = f"{self.selected_pos} -> {clicked}"
            self.selected_pos = None
            self.valid_moves  = []
            if self.game.isCheckMate():
                self.game_over = True; self.winner = cp
            else:
                self.game.switchPlayer()
        else:
            self.message      = "Deplacement invalide."
            self.selected_pos = None
            self.valid_moves  = []

    # --- boucle principale ---
    def run(self):
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()

                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    px, py = event.pos
                    if (BOARD_X <= px < BOARD_X + BOARD_SIZE and
                            BOARD_Y <= py < BOARD_Y + BOARD_SIZE):
                        self._handle_click(px, py)

                    if self.btn_save.is_clicked(event):
                        self.game.save_game()
                        self.message = "Partie sauvegardee !"

                    if self.btn_load.is_clicked(event):
                        if self.game.load_game():
                            self.selected_pos = None; self.valid_moves = []
                            self.game_over = False;   self.winner = None
                            self.message   = "Partie chargee !"
                        else:
                            self.message = "Aucune sauvegarde trouvee."

                    if self.btn_restart.is_clicked(event):
                        self.selected_pos = None; self.valid_moves = []
                        self.message = ""
                        self._show_start_screen()

            if (not self.game_over and self.game.currentPlayer and
                    isinstance(self.game.currentPlayer, AIPlayer)):
                self._do_ai_turn()

            self.screen.fill(BG_COLOR)
            self._draw_board()
            self._draw_pieces()
            self._draw_labels()
            self._draw_panel()

            if self.game_over and self.winner:
                ov = pygame.Surface((WIN_W, WIN_H), pygame.SRCALPHA)
                ov.fill((0, 0, 0, 150))
                self.screen.blit(ov, (0, 0))
                self._text(self.screen, "ECHEC ET MAT",
                           self.font_title, (255, 210, 50), WIN_W // 2, WIN_H // 2 - 30)
                self._text(self.screen, f"{self.winner.get_name()} remporte la partie !",
                           self.font_info, (240, 200, 120), WIN_W // 2, WIN_H // 2 + 10)
                self._text(self.screen, "Cliquez sur Nouvelle partie",
                           self.font_info, PANEL_TEXT2, WIN_W // 2, WIN_H // 2 + 45)

            pygame.display.flip()
            self.clock.tick(60)


