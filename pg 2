#  12. CHESS
# ══════════════════════════════════════════════════════════════════════════════
_PIECE_LETTER_MAP = {'K': King, 'Q': Queen, 'B': Bishop, 'N': Knight, 'R': Rook, 'P': Pawn}

class Chess:
    def __init__(self):
        self.board:         Board  = Board()
        self.players:       list   = []
        self.currentPlayer: Player = None

    def _parse_move(self, move: str):
        m = re.match(r'^([KQBNRP])([a-h][1-8])\s+([KQBNRP])([a-h][1-8])$',
                     move.strip(), re.IGNORECASE)
        if not m: raise ValueError(f"Format invalide : '{move}'")
        return (m.group(1).upper(), Position.from_string(m.group(2).lower()),
                m.group(3).upper(), Position.from_string(m.group(4).lower()))

    def is_castling_valid(self, king: "King", kingside: bool) -> bool:
        """
        Vérifie toutes les conditions du roque :
        1. Ni le roi ni la tour concernée n'ont bougé
        2. Les cases entre eux sont vides
        3. Le roi n'est pas en échec
        4. Le roi ne passe pas par une case menacée
        5. La case d'arrivée du roi n'est pas menacée
        """
        color = king.get_color()
        opp   = BLACK if color == WHITE else WHITE
        row   = 1 if color == WHITE else 8

        # Tour concernée
        rook_col  = 'h' if kingside else 'a'
        rook_pos  = Position(rook_col, row)
        rook      = self.board.getPiece(rook_pos)
        if rook is None or not isinstance(rook, Rook): return False
        if rook.get_color() != color:                  return False

        # Ni le roi ni la tour ne doivent avoir bougé
        if self.board.has_moved(king): return False
        if self.board.has_moved(rook): return False

        # Cases entre roi et tour doivent être vides
        king_col  = king.get_position().col_index()   # toujours 4 (colonne e)
        rook_col_i = rook_pos.col_index()
        step = 1 if rook_col_i > king_col else -1
        for ci in range(king_col + step, rook_col_i, step):
            if self.board.getPiece(Position(VALID_COLUMNS[ci], row)) is not None:
                return False

        # Le roi ne doit pas être en échec
        if self._is_in_check(color): return False

        # Le roi ne doit pas traverser ni atterrir sur une case menacée
        dest_col = king_col + 2 * step   # case d'arrivée du roi
        for ci in [king_col + step, dest_col]:
            if self._is_threatened(Position(VALID_COLUMNS[ci], row), opp):
                return False

        return True

    def isValidMove(self, move: str) -> bool:
        try:
            lf, fp, lt, tp = self._parse_move(move)
        except ValueError:
            return False
        if lf != lt: return False
        piece = self.board.getPiece(fp)
        if piece is None: return False
        if not isinstance(piece, _PIECE_LETTER_MAP[lf]): return False
        if piece.get_color() != self.currentPlayer.get_color(): return False
        # Vérifier la règle de déplacement de la pièce
        if not piece.isValidMove(tp, self.board): return False

        # Cas spécial : roque (roi bouge de 2 cases)
        if isinstance(piece, King):
            dc = tp.col_index() - fp.col_index()
            if abs(dc) == 2:
                kingside = dc > 0
                return self.is_castling_valid(piece, kingside)

        # Vérifier que ce coup ne laisse PAS notre propre roi en échec
        color = self.currentPlayer.get_color()
        if self._move_leaves_king_in_check(piece, tp, color): return False
        return True

    def updateBoard(self, move: str):
        _, fp, _, tp = self._parse_move(move)
        piece = self.board.getPiece(fp)
        # Cas spécial : roque
        if isinstance(piece, King):
            dc = tp.col_index() - fp.col_index()
            if abs(dc) == 2:
                kingside  = dc > 0
                row       = fp.get_row()
                rook_from = Position('h' if kingside else 'a', row)
                rook_to   = Position('f' if kingside else 'd', row)
                rook      = self.board.getPiece(rook_from)
                king_dest = tp
                self.board.castle_move(piece, rook, king_dest, rook_to)
                return
        self.board.move_piece(piece, tp)

    def switchPlayer(self):
        self.currentPlayer = (self.players[1] if self.currentPlayer is self.players[0]
                              else self.players[0])

    def _find_king(self, color: int):
        for p in self.board.get_all_pieces(color):
            if isinstance(p, King): return p
        return None

    def _is_threatened(self, position: Position, by_color: int) -> bool:
        for p in self.board.get_all_pieces(by_color):
            try:
                if p.isValidMove(position, self.board): return True
            except Exception: continue
        return False

    def _is_in_check(self, color: int) -> bool:
        king = self._find_king(color)
        if king is None: return False
        return self._is_threatened(king.get_position(), BLACK if color == WHITE else WHITE)

    def _move_leaves_king_in_check(self, piece, dest, color):
        """Simule un coup, vérifie si le roi reste en échec, puis annule tout."""
        old      = piece.get_position()
        captured = self.board.getPiece(dest)

        # --- Simulation directe sans passer par move_piece (évite de toucher __moved) ---
        del self.board._Board__pieces[old]
        if captured is not None:
            self.board._Board__pieces.pop(dest, None)
        piece._position = dest
        self.board._Board__pieces[dest] = piece

        king  = self._find_king(color)
        still = king is not None and self._is_threatened(
            king.get_position(), BLACK if color == WHITE else WHITE)

        # --- Annulation ---
        del self.board._Board__pieces[dest]
        piece._position = old
        self.board._Board__pieces[old] = piece
        if captured is not None:
            captured._position = dest
            self.board._Board__pieces[dest] = captured

        return still

    def isCheckMate(self) -> bool:
        color = self.currentPlayer.get_color()
        opp   = BLACK if color == WHITE else WHITE
        king  = self._find_king(color)
        if king is None: return True
        if not self._is_threatened(king.get_position(), opp): return False
        for piece in self.board.get_all_pieces(color):
            for col in VALID_COLUMNS:
                for row in range(1, 9):
                    dest = Position(col, row)
                    if dest == piece.get_position(): continue
                    try:
                        if not piece.isValidMove(dest, self.board): continue
                        # Le roque ne sort pas d'un échec — ignorer ici
                        if isinstance(piece, King) and abs(dest.col_index() - piece.get_position().col_index()) == 2:
                            continue
                        if not self._move_leaves_king_in_check(piece, dest, color):
                            return False
                    except Exception: continue
        return True

    def save_game(self, filepath: str = SAVE_FILE):
        data = {
            'board': self.board.to_dict(),
            'players': [{'name': p.get_name(), 'color': p.get_color(),
                         'is_ai': isinstance(p, AIPlayer)} for p in self.players],
            'current_player_index': self.players.index(self.currentPlayer)
        }
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

    def load_game(self, filepath: str = SAVE_FILE) -> bool:
        if not os.path.exists(filepath): return False
        with open(filepath, 'r', encoding='utf-8') as f:
            data = json.load(f)
        self.board   = Board.from_dict(data['board'])
        self.players = []
        for pd in data['players']:
            cls = AIPlayer if pd['is_ai'] else Player
            self.players.append(cls(pd['name'], pd['color']))
        self.currentPlayer = self.players[data['current_player_index']]
        return True


