#  3-8. PIÈCES
# ══════════════════════════════════════════════════════════════════════════════
class King(Piece):
    def __str__(self): return 'K'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        # Déplacement normal : 1 case dans n'importe quelle direction
        if dc <= 1 and dr <= 1 and (dc + dr) > 0:
            return True
        # Roque : le roi se déplace de 2 cases sur la même rangée
        # La validation complète (cases libres, non menacées, pas déjà bougé)
        # est faite dans Chess.is_castling_valid() — ici on accepte juste le format
        if dr == 0 and dc == 2:
            return True   # Chess.isValidMove() fera la vérification complète
        return False

class Queen(Piece):
    def __str__(self): return 'Q'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if not (((dc == 0 or dr == 0) and dc + dr > 0) or (dc == dr and dc > 0)): return False
        return self._path_clear(newPosition, board)

class Bishop(Piece):
    def __str__(self): return 'B'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if dc != dr or dc == 0: return False
        return self._path_clear(newPosition, board)

class Knight(Piece):
    def __str__(self): return 'N'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        return (dc == 2 and dr == 1) or (dc == 1 and dr == 2)

class Rook(Piece):
    def __str__(self): return 'R'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        dc = abs(newPosition.col_index() - self._position.col_index())
        dr = abs(newPosition.row_index() - self._position.row_index())
        if not ((dc == 0 and dr > 0) or (dr == 0 and dc > 0)): return False
        return self._path_clear(newPosition, board)

class Pawn(Piece):
    def __str__(self): return 'P'
    def isValidMove(self, newPosition, board):
        if self._is_same_color_at(newPosition, board): return False
        cn, rn = self._position.col_index(), self._position.row_index()
        cd, rd = newPosition.col_index(),    newPosition.row_index()
        d  = 1 if self._color == WHITE else -1
        sr = 1 if self._color == WHITE else 6
        dc, dr = cd - cn, rd - rn
        if dc == 0 and dr == d:
            return board.getPiece(newPosition) is None
        if dc == 0 and dr == 2 * d and rn == sr:
            mid = Position(VALID_COLUMNS[cn], self._position.get_row() + d)
            return board.getPiece(mid) is None and board.getPiece(newPosition) is None
        if abs(dc) == 1 and dr == d:
            t = board.getPiece(newPosition)
            return t is not None and t.get_color() != self._color
        return False


